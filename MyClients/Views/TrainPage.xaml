<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MyClients.Views.Controls"
             x:Class="MyClients.Views.TrainPage">
	<Grid>
		<!-- background -->
		<Image Source="background_blured.png"
		       SemanticProperties.Description="background"
		       Aspect="AspectFill"/>
		<!-- page -->
		<Grid RowDefinitions="*, 9*, *">
			
			<!-- header -->
			<controls:HeaderView Grid.Row="0" HeaderText="New Training"/>
			<!-- main information -->
			<ScrollView Grid.Row="1">
				<Grid RowDefinitions="10*, *"
				      ColumnDefinitions="*, *"
				      Margin="20">
					<!-- log -->
					<VerticalStackLayout Grid.Row="0"
					                     Grid.Column="0"
					                     Padding="0 10 0 0"
					                     Spacing="10">
						<Label Text="{Binding TrainingDateString}"
						       TextColor="Black"
						       FontAttributes="Bold, Italic"
						       HorizontalTextAlignment="Center"
						       HorizontalOptions="Center"
						       FontSize="30"/>
						
						<Border StrokeShape="RoundRectangle 15"
						        BackgroundColor="#D9D9D9"
						        StrokeThickness="0"
						        Padding="5">
							<Label Text="Training Log"
							       TextColor="Black"
							       FontAttributes="Bold, Italic"
							       HorizontalTextAlignment="Center"
							       HorizontalOptions="Center"
							       FontSize="24"/>
						</Border>
						
						<!-- logs container -->
						<Border StrokeShape="RoundRectangle 10"
						        StrokeThickness="1"
						        Stroke="Black">
							<Editor x:Name="TrainingLogEditor"
							        Placeholder="Type your training progress here..."
							        FontAttributes="Bold, Italic"
							        AutoSize="TextChanges"
							        BackgroundColor="#D9D9D9"
							        Opacity="0.75"
							        TextColor="Black"/>
						</Border>
					</VerticalStackLayout>
					<!-- attempts -->
					<VerticalStackLayout Grid.Row="0"
					                     Grid.Column="1"
					                     Spacing="10"
					                     Margin="0 0 0 10">
						<Label x:Name="TrainingTimerLabel"
						       Text="{Binding TimerString}"
						       TextColor="Black"
						       FontAttributes="Bold, Italic"
						       HorizontalTextAlignment="Center"
						       HorizontalOptions="Center"
						       FontSize="30"/>
						
						<Border StrokeShape="RoundRectangle 15"
						        BackgroundColor="#D9D9D9"
						        Padding="5">
							<Label Text="Attempts"
							       TextColor="Black"
							       FontAttributes="Bold, Italic"
							       HorizontalTextAlignment="Center"
							       HorizontalOptions="Center"
							       FontSize="24"/>
						</Border>
						
						<!-- Add attempt button -->
						<Button Text="+ Add"
						        TextColor="Black"
						        BackgroundColor="DarkRed"
						        FontSize="24"
						        FontAttributes="Bold, Italic"
						        Clicked="OnAddAttemptClicked"/>
						
						<VerticalStackLayout x:Name="TrainingAttemptsContainer"
						                     Spacing="10"/>
						
					</VerticalStackLayout>
				</Grid>
			</ScrollView>
			
			<!-- buttons -->
			<Grid Grid.Row="2"
			      ColumnDefinitions="*, *"
			      Margin="10 20">
				<!-- pause button -->
				<Border Grid.Column="0"
				        BackgroundColor="#797979"
				        StrokeShape="RoundRectangle 15"
				        Margin="0 10 0 0">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnPauseOrResumeTrainingClicked"/>
					</Border.GestureRecognizers>
					<Label x:Name="PauseResumeButtonLabel"
					       Text="Pause"
					       TextColor="Black"
					       FontSize="24"
					       FontAttributes="Bold, Italic"
					       HorizontalTextAlignment="Center"
					       HorizontalOptions="Center"
					       VerticalOptions="Center"/>
				</Border>
				<!-- finish button -->
				<Border Grid.Column="1"
				        BackgroundColor="DarkRed"
				        StrokeShape="RoundRectangle 15"
				        Margin="0 0 0 10">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnFinishTrainingClicked"/>
					</Border.GestureRecognizers>
					<Label Text="Finish"
					       TextColor="Black"
					       FontSize="24"
					       FontAttributes="Bold, Italic"
					       HorizontalTextAlignment="Center"
					       HorizontalOptions="Center"
					       VerticalOptions="Center"/>
				</Border>
			</Grid>
			
		</Grid>
	</Grid>
</ContentPage>