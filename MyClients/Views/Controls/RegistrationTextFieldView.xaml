<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyClients.Views.Controls.RegistrationTextFieldView"
             x:Name="Root">
	<Border StrokeShape="RoundRectangle 20"
	        BackgroundColor="Gray"
	        HeightRequest="45"
	        StrokeThickness="0">
		<Entry x:Name="InnerEntry"
		       Text="{Binding Text, Source={x:Reference Root}}"
		       Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
		       PlaceholderColor="{Binding PlaceholderColor, Source={x:Reference Root}}"
		       IsPassword="{Binding IsPassword, Source={x:Reference Root}}"
		       Keyboard="{Binding Keyboard, Source={x:Reference Root}}"
		       TextColor="Black"
		       ClearButtonVisibility="WhileEditing"
		       Margin="0 15"
		       VerticalOptions="Center"/>
	</Border>
</ContentView>
