<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MyClients.Views.Controls"
             x:Class="MyClients.Views.ProfilePage">
	<Grid>
		<!-- background -->
		<Image Source="background_blured.png"
		       SemanticProperties.Description="background"
		       Aspect="AspectFill"/>
		<!-- page -->
		<Grid RowDefinitions="*, 9*, *">
			
			<!-- header -->
			<controls:HeaderView Grid.Row="0" HeaderText="Profile"/>
			<!-- main information -->
			<ScrollView Grid.Row="1">
				<VerticalStackLayout>
					
				</VerticalStackLayout>
			</ScrollView>
			
		</Grid>
	</Grid>
</ContentPage>