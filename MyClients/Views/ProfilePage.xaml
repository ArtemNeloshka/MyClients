<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MyClients.Views.Controls"
             x:Class="MyClients.Views.ProfilePage">
	<Grid>
		<!-- background -->
		<Image Source="background_blured.png"
		       SemanticProperties.Description="background"
		       Aspect="AspectFill"/>
		<!-- page -->
		<Grid RowDefinitions="*, 9*, *">
			
			<!-- header -->
			<controls:HeaderView Grid.Row="0" HeaderText="Profile"/>
			<!-- main information -->
			<ScrollView Grid.Row="1">
				<VerticalStackLayout Margin="20 30">
					<!-- container -->
					<Border BackgroundColor="#565656"
					        StrokeShape="RoundRectangle 20"
					        StrokeThickness="0"
					        Padding="15">
						<Grid RowDefinitions="Auto, Auto">
							<!-- person info -->
							<Grid Grid.Row="0"
							      RowDefinitions="*, *, *"
							      ColumnDefinitions="2*, 2*, *">
								<!-- user name -->
								<Border Grid.Row="0"
								        Grid.Column="0"
								        StrokeShape="RoundRectangle 7"
								        StrokeThickness="0"
								        BackgroundColor="#D9D9D9"
								        Margin="0 5 0 0">
									<Label Text="Username"
									       HorizontalOptions="Center"
									       VerticalOptions="Center"
									       FontAttributes="Bold, Italic"/>
								</Border>
								<!-- user surname -->
								<Border Grid.Row="0"
								        Grid.Column="1"
								        StrokeShape="RoundRectangle 7"
								        StrokeThickness="0"
								        BackgroundColor="#D9D9D9"
								        Margin="0 10 0 5">
									<Label Text="Surname"
									       HorizontalOptions="Center"
									       VerticalOptions="Center"
									       FontAttributes="Bold, Italic"/>
								</Border>
								<!-- user favorite discipline -->
								<Border Grid.Row="1"
								        Grid.Column="0"
								        StrokeShape="RoundRectangle 7"
								        StrokeThickness="0"
								        BackgroundColor="#D9D9D9"
								        Margin="10 5 0 0">
									<Border.GestureRecognizers>
										<TapGestureRecognizer Tapped="OnDisciplinePickerTapped"/>
									</Border.GestureRecognizers>
    
									<Label x:Name="DisciplineLabel"
									       Text="Favorite discipline"
									       FontAttributes="Bold, Italic"
									       HorizontalTextAlignment="Center"
									       VerticalOptions="Center"/>
								</Border>
								<!-- user birth date -->
								<Border Grid.Row="1"
								        Grid.Column="1"
								        StrokeShape="RoundRectangle 7"
								        StrokeThickness="0"
								        BackgroundColor="#D9D9D9"
								        Margin="10 10 0 5">
									<Label Text="01.01.2000"
									       HorizontalOptions="Center"
									       VerticalOptions="Center"
									       FontAttributes="Bold, Italic"/>
								</Border>
								<!-- user picture -->
								<Border Grid.Row="0"
								        Grid.RowSpan="2"
								        Grid.Column="2"
								        StrokeThickness="0"
								        StrokeShape="RoundRectangle 100">
									<Image Source="user_icon.png"
									       BackgroundColor="White">
									</Image>
								</Border>
								<!-- user email -->
								<Border Grid.Row="2"
								        Grid.Column="0"
								        Grid.ColumnSpan="2"
								        StrokeShape="RoundRectangle 7"
								        StrokeThickness="0"
								        BackgroundColor="#D9D9D9"
								        Margin="10 10 0 0"
								        Padding="5">
									<Label Text="Username@gmail.com"
									       HorizontalOptions="Center"
									       VerticalOptions="Center"
									       FontAttributes="Bold, Italic"/>
								</Border>
								<!-- edit button -->
								<Border Grid.Row="2"
								        Grid.Column="2"
								        StrokeShape="RoundRectangle 7"
								        StrokeThickness="0"
								        Margin="10 0 0 0"
								        BackgroundColor="DarkRed"
								        Padding="5">
									<Label Text="Edit"
									        FontAttributes="Bold, Italic"
									        HorizontalOptions="Center"
									        VerticalOptions="Center"
									        HorizontalTextAlignment="Center"/>
								</Border>
							</Grid>
							
							<!-- Grades info -->
							<Grid RowDefinitions="3"
							      ColumnDefinitions="2">
								<!-- best grades article -->
								<Label Grid.Row="0"
								       Grid.Column="0"
								       Grid.ColumnSpan="2"
								       Text="Best Grades"/>
								<!-- bouldering section -->
								<Grid Row="0"
								      Column="0"
								      ColumnDefinitions="2">
									<!-- bouldering best grade -->
									<Border Grid.Column="0">
										<Label Text="Bouldering"/>
									</Border>
									<!-- grade -->
									<Border Grid.Column="1">
										<Label Text="7a"/>
									</Border>
								</Grid>
								<!-- top rope section -->
								<Grid Row="0"
								      Column="1"
								      ColumnDefinitions="2">
									<!-- top rope best grade -->
									<Border Grid.Column="0">
										<Label Text="Top rope:"/>
									</Border>
									<!-- grade -->
									<Border Grid.Column="1">
										<Label Text="7b"/>
									</Border>
								</Grid>
								<!-- Lead section -->
								<Grid Row="1"
								      Column="0"
								      ColumnDefinitions="2">
									<!-- lead best grade -->
									<Border Grid.Column="0">
										<Label Text="Lead"/>
									</Border>
									<!-- grade -->
									<Border Grid.Column="1">
										<Label Text="7a+"/>
									</Border>
								</Grid>
								<!-- speed section -->
								<Grid Row="1"
								      Column="1"
								      ColumnDefinitions="2">
									<!-- speed best grade -->
									<Border Grid.Column="0">
										<Label Text="Speed"/>
									</Border>
									<!-- grade -->
									<Border Grid.Column="1">
										<Label Text="-"/>
									</Border>
								</Grid>
							</Grid>
						</Grid>
					</Border>
					
					<!-- Log out button -->
					<Button Text="Log out"
					        BackgroundColor="DarkRed"
					        FontAttributes="Bold, Italic"
					        TextColor="Black"
					        FontSize="20"
					        HorizontalOptions="Center"
					        Margin="15"
					        Clicked="OnGoToLoginPageClicked"/>
				</VerticalStackLayout>
			</ScrollView>
			
		</Grid>
	</Grid>
</ContentPage>