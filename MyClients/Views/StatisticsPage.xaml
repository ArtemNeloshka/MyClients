<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MyClients.Views.Controls"
             x:Class="MyClients.Views.StatisticsPage">
	<Grid>
		<!-- background -->
		<Image Source="background_blured.png"
		       SemanticProperties.Description="background"
		       Aspect="AspectFill"/>
		<!-- page -->
		<Grid RowDefinitions="*, 9*, *">
			
			<!-- header -->
			<controls:HeaderView Grid.Row="0" HeaderText="Statistics"/>
			<!-- main information -->
			<ScrollView Grid.Row="1">
				<VerticalStackLayout>
					<Border StrokeShape="RoundRectangle 25"
					        StrokeThickness="0"
					        Margin="20 30"
					        HorizontalOptions="Start"
					        HeightRequest="250">
						<Grid>
							<ImageButton Source="workouts_archive_background.png"
										       Aspect="AspectFill"
										       VerticalOptions="Start"
										       CornerRadius="25"
										       Clicked="OnOpenWorkoutsArchivePageClicked">
							</ImageButton>
							<Label Text="Workouts Archive"
							       HorizontalOptions="Center"
							       Margin="15"
							       FontAttributes="Bold, Italic"
							       FontSize="36"
							       TextColor="White"/>
						</Grid>
					</Border>
				</VerticalStackLayout>
			</ScrollView>
			
		</Grid>
	</Grid>
</ContentPage>