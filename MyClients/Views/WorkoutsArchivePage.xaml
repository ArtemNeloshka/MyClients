<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MyClients.Views.Controls"
             xmlns:viewModels="clr-namespace:MyClients.ViewModels"
             xmlns:models="clr-namespace:MyClients.Models"
             x:Class="MyClients.Views.WorkoutsArchivePage">
	<Grid>
		<!-- background -->
		<Image Source="background_blured.png"
		       SemanticProperties.Description="background"
		       Aspect="AspectFill"/>
		<!-- page -->
		<Grid RowDefinitions="*, 9*">
			
			<!-- header -->
			<controls:HeaderView Grid.Row="0" HeaderText="Archive"/>
			<!-- main information -->
			<ScrollView Grid.Row="1">
				<VerticalStackLayout x:Name="WorkoutsContainerVerticalStackLayout"
				                     BindableLayout.ItemsSource="{Binding TrainingCards}"
				                     Spacing="15" 
				                     Margin="15">
    
			    <BindableLayout.ItemTemplate>
				    <DataTemplate>
			        <Border BackgroundColor="#D9D9D9"
								StrokeThickness="0">
				        <Border.StrokeShape>
									<RoundRectangle CornerRadius="15" />
				        </Border.StrokeShape>
				        
				        <Grid>
			          <Image Source="workouts_archive_background.png"
			                 Aspect="AspectFit"
			                 Opacity="0.5" />

			          <Grid RowSpacing="10" 
			                ColumnSpacing="10" 
			                Padding="10">
				          <Grid.RowDefinitions>
					          <RowDefinition Height="*" />
					          <RowDefinition Height="*" />
					          <RowDefinition Height="*" />
					          <RowDefinition Height="*" />
				          </Grid.RowDefinitions>
				          <Grid.ColumnDefinitions>
					          <ColumnDefinition Width="*" />
					          <ColumnDefinition Width="*" />
				          </Grid.ColumnDefinitions>

				          <Label Grid.Row="0" Grid.Column="0" 
				                 Text="{Binding TrainingDate}"
				                 FontSize="32" 
				                 HorizontalOptions="Start" 
				                 VerticalOptions="Start" 
				                 FontAttributes="Bold, Italic" />
			                        
				          <Label Grid.Row="0" Grid.Column="1" 
				                 Text="{Binding TrainingDuration}" 
				                 FontSize="32" 
				                 HorizontalOptions="End" 
				                 VerticalOptions="Start" 
				                 FontAttributes="Bold, Italic" />

				          <Label Grid.Row="1" Grid.Column="0" 
				                 Text="Disciplines trained:" 
				                 FontSize="20" 
				                 HorizontalOptions="Start" 
				                 VerticalOptions="Center" 
				                 FontAttributes="Bold, Italic" />
			                        
				          <Label Grid.Row="1" Grid.Column="1" 
				                 Text="Best grades&#x0a;climbed:" 
				                 FontSize="20" 
				                 HorizontalOptions="End" 
				                 VerticalOptions="Center" 
				                 FontAttributes="Bold, Italic" />
			                        
				          <Label Grid.Row="2" Grid.Column="0" 
				                 Text="{Binding DisciplinesTrained}" 
				                 FontSize="20" 
				                 HorizontalOptions="Start" 
				                 VerticalOptions="Start" 
				                 FontAttributes="Bold, Italic" />
			                        
				          <Label Grid.Row="2" Grid.Column="1" 
				                 Text="{Binding BestGradesClimbed}" 
				                 FontSize="20" 
				                 HorizontalOptions="End" 
				                 VerticalOptions="Start" 
				                 FontAttributes="Bold, Italic" />

				          <Label Grid.Row="3" Grid.Column="0" 
				                 Text="{Binding ClimbingGym}" 
				                 FontSize="20" 
				                 HorizontalOptions="Start" 
				                 VerticalOptions="End" 
				                 FontAttributes="Bold, Italic" />
			                        
				          <Border Grid.Row="3" Grid.Column="1" 
				                  BackgroundColor="Brown" 
				                  Padding="5" 
				                  HorizontalOptions="End" 
				                  VerticalOptions="End" 
				                  StrokeThickness="0">
					          <Border.StrokeShape>
						          <RoundRectangle CornerRadius="15" />
					          </Border.StrokeShape>
			                            
					          <Border.GestureRecognizers>
						          <TapGestureRecognizer Command="{Binding Source={
						          RelativeSource AncestorType={
						          x:Type viewModels:WorkoutsArchiveViewModel}}, Path=GoToDetailsCommand}" 
						                                CommandParameter="{Binding TrainingId}" />
					          </Border.GestureRecognizers>

					          <Label Text="View more" 
					                 TextColor="Black" 
					                 FontSize="20" 
					                 FontAttributes="Bold, Italic" />
				          </Border>
			          </Grid>
				        </Grid>
			        </Border>
				    </DataTemplate>
			    </BindableLayout.ItemTemplate>
				</VerticalStackLayout>
			</ScrollView>
		</Grid>
	</Grid>
</ContentPage>
