<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyClients.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MyClients"
    xmlns:views="clr-namespace:MyClients.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="MyClients"
    
    Shell.TabBarBackgroundColor="#222222"
    Shell.TabBarForegroundColor="Yellow">
    
    <TabBar>
        <Tab Title="Home" Icon="home_icon.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage"/>
        </Tab>
	    
        <Tab Title="Disciplines" Icon="disciplines_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:DisciplinesPage}" />
        </Tab>
	    
        <Tab Title="Train" Icon="train_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:TrainPage}" />
        </Tab>
	    
        <Tab Title="Statistics" Icon="statistics_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:StatisticsPage}" />
        </Tab>
	    
        <Tab Title="Profile" Icon="user_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" />
        </Tab>
    </TabBar>

</Shell>
